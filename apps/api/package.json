{
  "name": "@campuslink/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "docs:gen": "tsx src/scripts/gen-docs.ts",
    "vapid": "tsx src/scripts/vapid.ts",
    "feeds:verify": "tsx src/scripts/feeds-verify.ts",
    "jobs:verify": "tsx src/scripts/jobs-verify.ts",
    "roadmaps:verify": "tsx src/scripts/roadmaps-verify.ts",
    "loadtest": "tsx --env-file-if-exists=../../.env src/scripts/loadtest.ts",
    "study:perf": "tsx --env-file-if-exists=../../.env src/scripts/study-perf.ts",
    "rotate-field-key": "tsx --env-file-if-exists=../../.env src/scripts/rotate-field-key.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
