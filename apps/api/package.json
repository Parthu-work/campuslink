    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "mongoose": "^9.11.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
