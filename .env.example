# ─── CampusLink environment variables ────────────────────────────────────────
# Copy to .env (`cp .env.example .env`). Never commit .env. Every variable is
# validated at API startup (apps/api/src/config/env.ts); the app refuses to boot
# on a missing or malformed value.

# Runtime: development | test | production
NODE_ENV=development
# Port the API listens on
API_PORT=4000
# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Root domain used to resolve tenants from subdomains (e.g. jntuh.localhost)
APP_ROOT_DOMAIN=localhost
# Public URL of the web app (used in emails and redirects)
WEB_ORIGIN=http://localhost:5173
# Comma-separated CORS allowlist. Wildcard subdomains are written as *.localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://*.localhost:5173

# MongoDB connection string (docker-compose runs a single-node replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/campuslink?replicaSet=rs0&directConnection=true
# Redis connection string (rate limits, BullMQ queues, Socket.io adapter)
REDIS_URL=redis://127.0.0.1:6379

# JWT signing secrets — at least 32 random bytes each. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
# Signs the 5-minute ticket between the password step and the 2FA step (refresh tokens are opaque, not JWTs)
JWT_TICKET_SECRET=change-me-ticket-secret-at-least-32-characters-long
# Access token lifetime in seconds (short-lived)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds (rotated on every use)
JWT_REFRESH_TTL_SECONDS=1209600

# 32-byte base64 key for application-level field encryption (AES-256-GCM).
# Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Retired keys during a rotation only (comma-separated, decrypt-only; docs/runbook.md)
FIELD_ENCRYPTION_KEYS_PREVIOUS=

# SMTP (Mailpit locally: UI at http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusLink <no-reply@campuslink.localhost>"
# smtp | disabled (disabled = keep mail in memory; used by end-to-end tests)
MAIL_DRIVER=smtp

# Phone codes and messages (B2, B3). console keeps them in memory: read them at
# GET /api/v1/dev/outbox?to=%2B91XXXXXXXXXX (never in production).
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
# Registered DLT template ids (docs/sms-templates.md), e.g. otp=1107161234567890123
# SMS_DLT_TEMPLATE_IDS=
# MSG91 (SMS_PROVIDER=msg91): auth key, DLT-approved six-letter header, principal entity id
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_DLT_ENTITY_ID=
# Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=cloud); webhook: https://admin.<root>/api/v1/webhooks/whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=
# WHATSAPP_AUTH_TEMPLATE=auth_code
# WHATSAPP_ACTION_SECRET=

# Billing (B10): the seller printed on invoices. Confirm the SAC code and GST rate with a CA.
BILLING_SELLER_NAME="CampusLink (demo seller)"
BILLING_SELLER_ADDRESS="Demo address, Hyderabad, Telangana 500001"
# Registered for GST: invoices carry CGST + SGST in the same state, IGST otherwise
BILLING_GST_REGISTERED=false
# BILLING_SELLER_GSTIN=
# GST state code of the seller (36 Telangana, 37 Andhra Pradesh, ...)
# BILLING_SELLER_STATE=36
# BILLING_GST_RATE=18
# BILLING_SAC_CODE=
BILLING_INVOICE_PREFIX=CL
BILLING_PAYMENT_TERMS_DAYS=30
# BILLING_BANK_DETAILS="A/c 000000000000, IFSC ABCD0000000, Demo Bank"
# Online payment: disabled | stub (development) | razorpay (Payment Links)
# webhook: https://admin.<root>/api/v1/webhooks/razorpay (event payment_link.paid)
PAYMENT_PROVIDER=stub
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Storage adapter: local | s3 (s3 is a stub until deployment)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Video adapter: jitsi | 100ms | daily (only jitsi is functional locally)
VIDEO_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# Self-hosted Jitsi with token auth (optional): links then carry a JWT that expires with the join window
# JITSI_APP_ID=
# JITSI_APP_SECRET=

# Bot protection adapter: none | turnstile (disabled locally)
BOT_PROTECTION=none
# TURNSTILE_SECRET=

# Web push (VAPID). Leave empty to disable push; generate with: pnpm --filter @campuslink/api vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@campuslink.localhost

# AI study assistant. The platform's provider is every college's default, metered against its plan's
# allowance (B11, ADR 0009); a college may still attach its own key in Admin › AI assistant:
# AI_DEFAULT_PROVIDER=anthropic
# AI_DEFAULT_API_KEY=
# Optional for Anthropic (answers default to claude-haiku-5-5; ADR 0009); required for other providers
# AI_DEFAULT_CHAT_MODEL=
# The "deep" model for heavy tasks (Anthropic default claude-sonnet-5-5)
# AI_DEFAULT_DEEP_MODEL=
# AI_DEFAULT_EMBEDDING_PROVIDER=openai
# AI_DEFAULT_EMBEDDING_API_KEY=
# AI_DEFAULT_EMBEDDING_MODEL=
# What the platform pays its provider per million tokens (the console's per-college cost estimate)
# AI_PLATFORM_PRICE_INPUT=
# AI_PLATFORM_PRICE_OUTPUT=
# AI_PLATFORM_PRICE_EMBEDDING=
# AI_PLATFORM_PRICE_CURRENCY=USD
# Private or plain-http endpoints colleges may use (origins, comma-separated), e.g. a local Ollama:
# AI_PRIVATE_ENDPOINTS=http://localhost:11434
# Study material processing. All optional: PDFs, documents, notes and uploaded captions work without them.
# OCR for scanned pages (auto: Tesseract when installed) and its languages, e.g. eng+tel
# OCR_PROVIDER=auto
# OCR_LANGUAGES=eng
# ffmpeg, ffprobe and pdftoppm for video length, poster frames, audio and scanned pages (auto: when installed)
# MEDIA_TOOLS=auto
# What this process does: all (API and background jobs; development), api (HTTP only, jobs are
# queued) or worker (jobs only: study processing with ffmpeg and Tesseract, embeddings, email).
# PROCESS_ROLE=all
# A local Whisper service for video and audio transcripts (nothing leaves the server)
# WHISPER_URL=http://localhost:9000
# Where passage vectors are indexed: auto (Qdrant when QDRANT_URL is set, else memory), memory or qdrant.
# Start Qdrant with: docker compose --profile qdrant up -d --wait qdrant
# VECTOR_STORE=auto
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# Re-order retrieved passages with the college's chat model (more tokens): none or llm
# AI_RERANKER=none

# Cookie Secure flag (defaults to true when NODE_ENV=production)
# COOKIE_SECURE=false
# Number of reverse proxies in front of the API (enables X-Forwarded-* trust). 0 locally.
TRUST_PROXY_HOPS=0

# Multiplies every rate limit (automated tests only; max 2 in production)
RATE_LIMIT_SCALE=1

# Password used for every seeded demo account (local only)
SEED_PASSWORD=Demo-Campus-Link-2026

# Breached-password check via HIBP k-anonymity range API. Fails open if unreachable.
HIBP_ENABLED=true

# News and job ingestion scheduler: RSS/Atom sources, job boards and daily job alerts (off in tests)
INGESTION_ENABLED=true

# Adzuna job search API (free tier; your own keys). Leave unset to keep the Adzuna adapter off.
# Results must show "Jobs by Adzuna" (the app does this).
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Web app (Vite exposes only VITE_-prefixed variables to the browser)
VITE_API_BASE_URL=http://localhost:4000/api/v1
