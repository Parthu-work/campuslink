# Production settings for one server (deploy/prod/compose.yml). Copy nothing by hand:
#   deploy/prod/gen-secrets.sh --domain <your-domain>
# writes `.env` from this file (mode 600) with every "generated" value filled in, and the database
# root secrets into ./secrets. Then fill in the values marked "owner". No real value belongs in
# this example. The API refuses to start on anything invalid and names the setting (never its value).

# ── Domain ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# owner: the root domain whose DNS is on Cloudflare. Colleges are <college>.<domain>, the platform
# console is admin.<domain>, employers are emp-<name>.<domain>.
APP_ROOT_DOMAIN=
# https://<domain>: links in emails are built as https://<college>.<domain>/... from this.
WEB_ORIGIN=
# Every college, employer and the platform host: https://*.<domain>
CORS_ALLOWED_ORIGINS=
# The edge (nginx) overwrites X-Forwarded-For with the address Cloudflare verified: exactly one hop.
TRUST_PROXY_HOPS=1
# Images: the registry path and the tag to run (the deploy workflow sets IMAGE_TAG to a commit SHA).
IMAGE_PREFIX=ghcr.io/parthu-work/campuslink
IMAGE_TAG=main
# Where the Origin CA certificate (fullchain.pem, privkey.pem) and the generated Cloudflare range
# files live on the server.
TLS_DIR=./tls
CLOUDFLARE_DIR=./cloudflare
# The network (ADR 0014, accepted by the owner on 11 Nov 2026): employer hosts, the recruiter portal,
# cross-college discovery, verified credentials. Each college still opts in (Admin › Network) and each
# member still opts in. false turns all of it off at once without deleting anything.
NETWORK_ENABLED=true

# ── Sessions and encryption (generated) ─────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_TICKET_SECRET=
FIELD_ENCRYPTION_KEY=
# Only during a key rotation (docs/runbook.md).
FIELD_ENCRYPTION_KEYS_PREVIOUS=
HIBP_ENABLED=true

# ── Database (generated) ────────────────────────────────────────────────────
# The application user: readWrite on this database only (deploy/prod/mongo-init.sh).
MONGO_APP_DB=campuslink
MONGO_APP_USER=campuslink_app
MONGO_APP_PASSWORD=
MONGODB_URI=

# ── Redis (generated) ───────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=
JOBS_DRIVER=bullmq

# ── Qdrant (generated) ──────────────────────────────────────────────────────
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── Storage (generated keys) ────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=campuslink-files
# SeaweedFS encrypts objects written with SSE-S3 using the key in ./secrets/seaweedfs-kek.
S3_SSE=AES256
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MALWARE_SCANNER=clamav
CLAMAV_ADDRESS=clamav:3310

# ── Mail (owner: a free SMTP tier, for example Brevo; record its daily limit) ──
# Required: production refuses MAIL_DRIVER=disabled.
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# A sender on a domain whose SPF, DKIM and DMARC records point at the SMTP provider.
MAIL_FROM=

# ── AI ──────────────────────────────────────────────────────────────────────
# Chat answers (owner: an Anthropic key with a monthly spend limit set in the Anthropic console).
# Leave the three lines empty to run without: the assistant then answers with passages only.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_API_KEY=
# What the platform pays per million tokens (from the provider's price list), for costs:report.
AI_PLATFORM_PRICE_INPUT=
AI_PLATFORM_PRICE_OUTPUT=
AI_PLATFORM_PRICE_EMBEDDING=0
AI_PLATFORM_PRICE_CURRENCY=USD
# Embeddings: free, on this server (the ollama service). The API may reach this private address
# only because AI_PRIVATE_ENDPOINTS lists exactly this origin; a college can never add one.
AI_DEFAULT_EMBEDDING_PROVIDER=openai_compatible
AI_DEFAULT_EMBEDDING_MODEL=nomic-embed-text
AI_DEFAULT_EMBEDDING_BASE_URL=http://ollama:11434/v1
AI_PRIVATE_ENDPOINTS=http://ollama:11434
# The pinned model's vector size (deploy-check fails if the model answers with another size).
AI_EMBEDDING_DIMENSIONS=768
OLLAMA_VERSION=0.12.6
# The worker image has ffmpeg and Tesseract (English, Telugu, Hindi).
OCR_PROVIDER=auto
OCR_LANGUAGES=eng+tel+hin
MEDIA_TOOLS=auto

# ── Channels (owner; each stays disabled until its account is ready) ────────
# WhatsApp (Meta Cloud API): needs business verification and approved templates.
WHATSAPP_PROVIDER=disabled
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
# generated: signs the quick-reply buttons.
WHATSAPP_ACTION_SECRET=
# SMS (MSG91, on a PREPAID balance): needs the DLT entity, header and templates.
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_IDS=
# Web push (generated).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:<owner's address>
VAPID_SUBJECT=
# What one message costs, in paise, and rupees per dollar: estimates for costs:report (owner, from
# the providers' current price lists). Empty: counts are shown without an amount.
COST_WHATSAPP_MESSAGE_PAISE=
COST_SMS_MESSAGE_PAISE=
COST_USD_INR=

# ── Payments (bank transfer first; Razorpay only when a college asks to pay online) ──
PAYMENT_PROVIDER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Billing seller details (owner, from the chartered accountant) ───────────
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
# false until the seller has a GSTIN; then set the GSTIN and the two-digit state code.
BILLING_GST_REGISTERED=false
BILLING_SELLER_GSTIN=
BILLING_SELLER_STATE=
BILLING_SAC_CODE=
BILLING_INVOICE_PREFIX=CL
BILLING_BANK_DETAILS=

# ── Monitoring ──────────────────────────────────────────────────────────────
# owner: the Sentry DSN (free plan). Reports are scrubbed before they leave (lib/error-reporter.ts).
ERROR_REPORTER=disabled
ERROR_REPORTER_DSN=
# generated: /api/v1/metrics answers only with this token, and only inside the server (nginx
# returns 404 for it from outside).
METRICS_TOKEN=
# Written by the nightly backup; costs:report reads it (mounted read-only in the API container).
BACKUP_STATUS_FILE=/var/lib/campuslink/status/backup-status.json

# ── Bot protection (optional; Cloudflare Turnstile is free) ─────────────────
BOT_PROTECTION=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Content ─────────────────────────────────────────────────────────────────
# News and job sources are fetched only for sources a college turned on.
INGESTION_ENABLED=true
