[Unit]
Description=CampusLink nightly backup to R2 (deploy/prod/backup.sh)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/campuslink/deploy/prod
ExecStart=/srv/campuslink/deploy/prod/backup.sh
Nice=10
IOSchedulingClass=idle
